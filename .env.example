# CanTheySeeIt example configuration
# Copy to .env and supply your own local test credentials.

CRAPI_ENABLE=false

CRAPI_A_EMAIL=your_test_account_a@example.com
CRAPI_A_PASSWORD=replace_with_test_password
CRAPI_A_VIN=YOUR_TEST_VIN_A

CRAPI_B_EMAIL=your_test_account_b@example.com
CRAPI_B_PASSWORD=replace_with_test_password
CRAPI_B_VIN=YOUR_TEST_VIN_B
